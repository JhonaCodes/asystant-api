# Load through your process manager / secret manager. Never bundle this in an app.
DATABASE_PATH=/data/asystant.db
ASYSTANT_BIND=0.0.0.0:8787

# Managed OpenRouter keys. Set both, or neither to disable issuance.
# OPENROUTER_MANAGEMENT_API_KEY: an OpenRouter management (provisioning) key of
# the organization that owns the tenants' workspaces. It can only create,
# inspect and disable keys; it cannot run inference.
# ASYSTANT_MANAGED_ENCRYPTION_KEY: 32 random bytes in base64 that seal issued
# keys at rest. Generate with: openssl rand -base64 32
# Rotating it makes the day's stored keys unreadable until they expire at the end
# of the UTC day; rotate at a day boundary.
# OPENROUTER_MANAGEMENT_API_KEY=replace-with-openrouter-management-key
# ASYSTANT_MANAGED_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
