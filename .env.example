# Load through your process manager / secret manager. Never bundle this in an app.
DATABASE_PATH=/data/asystant.db
ASYSTANT_BIND=0.0.0.0:8787

# Managed OpenRouter keys and the operator console. Set both, or neither.
# OPENROUTER_MANAGEMENT_API_KEY: an OpenRouter management (provisioning) key of
# the organization that owns the tenants' workspaces. It can only create,
# inspect and disable keys; it cannot run inference.
# ASYSTANT_MANAGED_ENCRYPTION_KEY: 32 random bytes in base64 that seal issued
# keys and the administrators' authenticator secrets.
# Generate with: openssl rand -base64 32
# Rotating it makes the day's stored keys unreadable until they expire at the
# end of the UTC day, and every administrator needs `admin reset`.
# OPENROUTER_MANAGEMENT_API_KEY=replace-with-openrouter-management-key
# ASYSTANT_MANAGED_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64

# The public origin of the console; forms from any other origin are refused.
# Without it the /admin console stays off.
# ASYSTANT_PUBLIC_ORIGIN=https://ai.jhonacode.com

# Optional: a header your edge proxy always overwrites with the caller address
# (for example CF-Connecting-IP or X-Real-IP). Needed behind a proxy for key
# source restrictions, sign-in lockout per address and audit sources.
# ASYSTANT_CLIENT_IP_HEADER=CF-Connecting-IP
